# Server
PORT=3000

# OpenRouter (AI fix generation)
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the model (default: qwen/qwen3-coder:free)
# OPENROUTER_MODEL=ling-3.0-flash

# GitHub (for cloning + PR creation)
GITHUB_TOKEN=your-github-token

# Demo repo (team-controlled)
DEMO_REPO_URL=https://github.com/your-org/your-demo-repo.git

# Routes to scan (comma-separated)
ROUTES=/,/contact,/products
